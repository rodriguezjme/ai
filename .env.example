# Copiá este archivo como .env para probar en tu compu. En el hosting, cargá estas variables en su panel.

# Clave larga y aleatoria para firmar las sesiones (obligatoria en producción)
SESSION_SECRET=cambiar-por-una-frase-larga-y-secreta

# Dirección pública del sitio (se usa en los links de los emails)
SITE_URL=http://localhost:3000

# Base de datos. Sin esto usa un archivo local amigo.db. En producción: Turso (gratis)
# DATABASE_URL=libsql://amigo-invisible-tuusuario.turso.io
# DATABASE_AUTH_TOKEN=...

# Email por Brevo (recomendado en Render, que bloquea SMTP en el plan gratis):
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Amigo Invisible <tuemail@gmail.com>

# O email por SMTP. Sin ninguno de los dos, los emails se muestran en la consola (modo prueba).
# Ejemplo con Gmail (requiere "contraseña de aplicación"):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# MAIL_FROM=Amigo Invisible <tucuenta@gmail.com>

# Contraseña del panel de administrador (/admin)
ADMIN_PASSWORD=cambiar

# Opcional: dirección del juego migrado desde la primera versión
# LEGACY_GAME_SLUG=primer-juego

NODE_ENV=development
